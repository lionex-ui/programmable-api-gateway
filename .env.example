# Application
APP_NAME=programmable-api-gateway
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Redis (for future use)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (for future use)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway

# Telemetry (for future use)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=programmable-api-gateway
